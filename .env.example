# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LANGUAGE_CODE=ru-ru
DJANGO_TIME_ZONE=Europe/Moscow

# Database: SQLite by default; set DB_ENGINE=postgres to use PostgreSQL.
DB_ENGINE=sqlite
# DB_ENGINE=postgres
POSTGRES_DB=investing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Tinkoff Invest API
TINKOFF_TOKEN=

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# API: false preserves the original open API; true requires authentication
# for write requests.
API_REQUIRE_AUTH=false

# Optional security settings (used when DJANGO_DEBUG=false)
# SECURE_SSL_REDIRECT=false
# SECURE_HSTS_SECONDS=0
# CSRF_TRUSTED_ORIGINS=https://example.com
